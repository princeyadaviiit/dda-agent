# ═══════════════════════════════════════════════════════════
# Delta Exchange India API Credentials
# ═══════════════════════════════════════════════════════════
# Get these from: Delta Exchange → Settings → API Management
# Security: Enable Read + Trade only. NEVER enable Withdraw.
# IP whitelist: ON (recommended for security)

DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
DELTA_BASE_URL=https://api.india.delta.exchange

# ═══════════════════════════════════════════════════════════
# Trading Configuration
# ═══════════════════════════════════════════════════════════

# Trading mode: "spot" or "futures"
TRADE_MODE=futures

# Paper trading mode (ALWAYS START WITH TRUE)
# true = simulates trades, logs to CSV, no real orders
# false = executes real trades on Delta Exchange
PAPER_TRADING=true

# Trading symbol (Delta format - automatically converted to Binance format)
# Examples: BTCUSD, ETHUSD, SOLUSD
# Note: Bot converts BTCUSD → BTCUSDT for Binance API
SYMBOL=BTCUSD

# Multi-timeframe configuration
# Higher Timeframe (HTF) - for trend direction
# Lower Timeframe (LTF) - for precise entry timing
TIMEFRAME_HTF=4H
TIMEFRAME_LTF=15m

# Supported timeframes:
# Minutes: 1m, 3m, 5m, 15m, 30m
# Hours: 1H, 2H, 4H, 6H, 8H, 12H
# Days: 1D, 3D
# Weeks: 1W
# Months: 1M

# ═══════════════════════════════════════════════════════════
# Multi-Strategy System Configuration
# ═══════════════════════════════════════════════════════════

# Enable/disable individual strategies (true/false)
# Strategy 1: CISD (Candle in Supply/Demand)
STRATEGY_1_ENABLED=true

# Strategy 2: FVG + CISD Combined
STRATEGY_2_ENABLED=true

# Strategy 3: Fibonacci Retracement (0.5, 0.618, 0.786)
STRATEGY_3_ENABLED=true

# Strategy 4: SMT Divergence (BTC vs ETH)
STRATEGY_4_ENABLED=true

# Secondary symbol for SMT Divergence Strategy (Strategy 4)
# Used to compare with primary SYMBOL for divergence detection
SMT_SECONDARY_SYMBOL=ETHUSD

# ═══════════════════════════════════════════════════════════
# Risk Management (CRITICAL - READ CAREFULLY)
# ═══════════════════════════════════════════════════════════

# Portfolio value — your total trading capital
PORTFOLIO_VALUE_USD=1000

# ────────────────────────────────────────────────────────────
# RISK PERCENTAGE CALCULATION EXPLAINED:
# ────────────────────────────────────────────────────────────
# Risk % is calculated on MARGIN (actual capital), NOT leveraged position size.
#
# Example with 1% risk:
#   Portfolio: $1000
#   Risk per trade: 1% = $10 (this is your max loss if SL hits)
#   Entry: $50,000 | Stop Loss: $49,000 (2% away)
#   Required margin: $10 / 0.02 = $500
#   With 5x leverage: Position size = $500 × 5 = $2,500
#   If SL hits: You lose $10 (1% of portfolio), NOT $50
#
# This is the CORRECT way to calculate risk in leveraged trading.
# ────────────────────────────────────────────────────────────

# Risk per trade as percentage of portfolio (recommended: 0.5-2%)
# 0.5 = 0.5% risk per trade (conservative)
# 1.0 = 1% risk per trade (standard)
# 2.0 = 2% risk per trade (aggressive)
RISK_PER_TRADE_PERCENT=1.0

# Maximum portfolio allocation per trade (as percentage)
# This limits the MARGIN used per trade, regardless of risk calculation
# Example: 10% means max $100 margin on a $1000 portfolio
# Recommended: 5-20% for futures trading
MAX_PORTFOLIO_PER_TRADE_PERCENT=10.0

# Absolute maximum trade size in USD (hard cap)
# This overrides percentage calculations if they exceed this value
MAX_TRADE_SIZE_USD=100

# Maximum number of trades per day (across all strategies)
MAX_TRADES_PER_DAY=3

# Maximum daily loss as percentage of portfolio
# Bot stops trading if daily losses reach this threshold
# Example: 4% means bot stops after losing $40 on a $1000 portfolio
MAX_DAILY_LOSS_PERCENT=4.0

# Maximum number of concurrent open positions
# Recommended: 1-3 for beginners, 3-5 for experienced traders
MAX_OPEN_POSITIONS=2

# ═══════════════════════════════════════════════════════════
# Leverage & Position Sizing
# ═══════════════════════════════════════════════════════════

# Futures leverage (only applies when TRADE_MODE=futures)
# Higher leverage = higher risk. Recommended: 3-10x for crypto
LEVERAGE=5

# Position sizing method:
# "risk_based" = Calculate position size based on RISK_PER_TRADE_PERCENT and SL distance
# "fixed_percent" = Use fixed percentage of portfolio (MAX_PORTFOLIO_PER_TRADE_PERCENT)
# "fixed_usd" = Use fixed USD amount (MAX_TRADE_SIZE_USD)
# Recommended: "risk_based" for proper risk management
POSITION_SIZING_METHOD=risk_based

# ═══════════════════════════════════════════════════════════
# Stop Loss & Take Profit Configuration
# ═══════════════════════════════════════════════════════════

# Minimum risk:reward ratio (e.g., 2 means 1:2 RR minimum)
# Bot will reject trades with RR below this threshold
RISK_REWARD_RATIO=2.0

# Stop loss buffer in pips (to avoid stop hunts)
# 1 pip = 0.01% of price
# Recommended: 5-10 pips for crypto
SL_BUFFER_PIPS=5

# Take profit strategy:
# "fixed_rr" = Use fixed risk:reward ratio (RISK_REWARD_RATIO)
# "dynamic" = Adjust TP based on market structure (previous high/low)
# "trailing" = Use trailing stop after reaching 1:1.5 RR
TP_STRATEGY=fixed_rr

# Partial profit taking (true/false)
# If true, takes 50% profit at 1:2 RR, lets 50% run to full TP
ENABLE_PARTIAL_PROFITS=true

# Move stop loss to breakeven after reaching this RR
# Example: 1.5 means move SL to entry after 1:1.5 RR is reached
BREAKEVEN_RR_THRESHOLD=1.5

# ═══════════════════════════════════════════════════════════
# Trade Direction Permissions
# ═══════════════════════════════════════════════════════════

# Enable/disable trade directions globally
ALLOW_LONG=true               # Enable long (buy) trades
ALLOW_SHORT=true              # Enable short (sell) trades

# ═══════════════════════════════════════════════════════════
# Strategy-Specific Risk Multipliers (Advanced)
# ═══════════════════════════════════════════════════════════
# Adjust risk per strategy based on historical performance
# 1.0 = use standard risk, 0.5 = half risk, 1.5 = 1.5x risk

STRATEGY_1_RISK_MULTIPLIER=1.0
STRATEGY_2_RISK_MULTIPLIER=1.0
STRATEGY_3_RISK_MULTIPLIER=1.0
STRATEGY_4_RISK_MULTIPLIER=1.0

# ═══════════════════════════════════════════════════════════
# Position Monitoring
# ═══════════════════════════════════════════════════════════

# How often to check open positions for TP/SL hits (in seconds)
MONITOR_INTERVAL_SECONDS=30

# Enable console notifications for TP/SL hits
ENABLE_NOTIFICATIONS=true

# Auto-close positions after this many hours if no TP/SL hit (0 = disabled)
# Useful to prevent positions from staying open indefinitely
MAX_POSITION_HOLD_HOURS=24

# ═══════════════════════════════════════════════════════════
# Data Source Configuration
# ═══════════════════════════════════════════════════════════

# Market data is fetched from Binance Futures API (no auth required)
# No configuration needed - bot connects automatically
# API: https://fapi.binance.com
# Rate limit: 1200 requests/minute (bot uses ~2-10 per run depending on strategies)

# ═══════════════════════════════════════════════════════════
# TradingView Integration (Optional)
# ═══════════════════════════════════════════════════════════

# TradingView is ONLY used for post-trade visualization (optional)
# The bot does NOT require TradingView for market data or trading
# If you want to draw on TradingView after trades:
#   1. Install TradingView MCP
#   2. Use Claude Code to draw visual analysis
# This is completely optional - bot works without TradingView

# ═══════════════════════════════════════════════════════════
# Logging & Debugging
# ═══════════════════════════════════════════════════════════

# Log level: "minimal", "standard", "verbose", "debug"
LOG_LEVEL=standard

# Save detailed strategy analysis to JSON (true/false)
# Useful for backtesting and strategy optimization
SAVE_STRATEGY_ANALYSIS=true

# ═══════════════════════════════════════════════════════════
# Notes & Best Practices
# ═══════════════════════════════════════════════════════════

# 1. ALWAYS start with PAPER_TRADING=true
# 2. Use STRATEGY_MODE=single first to test original strategy
# 3. Switch to STRATEGY_MODE=multi only after understanding each strategy
# 4. Start with RISK_PER_TRADE_PERCENT=0.5 (conservative)
# 5. Review safety-check-log.json to understand bot decisions
# 6. Monitor positions with: npm run monitor
# 7. View dashboard at: npm run dashboard (http://localhost:3737)
# 8. Generate tax report: node bot.js --tax-summary
# 9. Bot runs autonomously - no Claude/AI required
# 10. Suitable for cron/scheduled execution
# 11. Deploy to Railway for 24/7 cloud execution

# ═══════════════════════════════════════════════════════════
# Risk Disclaimer
# ═══════════════════════════════════════════════════════════
# Trading cryptocurrencies with leverage involves substantial risk.
# Only trade with capital you can afford to lose.
# Past performance does not guarantee future results.
# This bot is provided as-is with no warranty.
# Always test in paper trading mode first.
